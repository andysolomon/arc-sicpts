{
  "name": "sicp-js-interactive",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @sicp/book",
    "build": "npm run build -w @sicp/book",
    "preview": "npm run preview -w @sicp/book",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "e2e": "npm run e2e -w @sicp/book",
    "sicp": "node packages/cli/src/main.ts",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.9"
  }
}
